      "type": "∀ (o : WatchPoll.PollingOptions) (s t : WatchPoll.State) (e : WatchPoll.Event), WatchPoll.pollStep o s e = some t → WatchPoll.HonestClock e t → WatchPoll.Stalls e t → e.outcome = WatchPoll.StepOutcome.continue_ ∨ e.outcome = WatchPoll.StepOutcome.sleep 0",
