      "name": "WatchPoll.zero_sleep_without_clock_repeats",
      "kind": "theorem",
      "type": "∀ (o : WatchPoll.PollingOptions) (s : WatchPoll.State), s.last = WatchPoll.Last.sleptPoll 0 → s.remaining.positive = true → s.failures = 0 → s.retries = 0 → WatchPoll.pollStep o s { outcome := WatchPoll.StepOutcome.sleep 0, stepElapsed := 0, sleepElapsed := 0 } = some s",
