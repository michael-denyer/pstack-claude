{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "grep -s '^session hook: off' \"$HOME/.claude/pstack-models.md\" >/dev/null || cat \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-context.md\"",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ]
  }
}
